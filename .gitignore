# AetherCore .gitignore

# C 编译产物
*.obj
*.exe
*.pdb
*.ilk
*.exp
*.lib

# Python 缓存
__pycache__/
*.pyc

# 订阅缓存 / 配置文件（含订阅密钥）
data/sub.b64
data/config.yaml
data/core.conf
data/core.log
data/traffic.log
data/cache.db
data/nodes_cache.json
data/app_rules.json

# 运行时
*.logdata/aethercore.pid
data/Override-Configuration.json
