<Window
    x:Class="OmniProxyGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="代理工具控制台">
    <Grid Background="{StaticResource BgBrush}">
        <ScrollViewer>
            <StackPanel Padding="18,16" Spacing="14" MaxWidth="1240" HorizontalAlignment="Center">

                <!-- ===== 顶部全局栏 ===== -->
                <Border x:Name="AppTitleBar" Style="{StaticResource CardStyle}" Padding="16,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                                Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="om" Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="代理工具控制台" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="omni-proxy / sing-box · 单页平铺 · 无分页" FontSize="11"
                                       Foreground="{StaticResource WeakBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <RadioButton x:Name="CoreOmni" Content="omni-proxy" GroupName="core" Tag="omni"
                                         IsChecked="True" Checked="Core_Checked"
                                         Foreground="{StaticResource InkBrush}" />
                            <RadioButton x:Name="CoreSb" Content="sing-box" GroupName="core" Tag="singbox"
                                         Checked="Core_Checked" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="OmniSection">
<TextBlock Text="omni-proxy 核心" Style="{StaticResource DividerTitle}" />

                <!-- ===== omni 状态条 ===== -->
                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                    <StackPanel Spacing="0">
                        <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="OmniDot" Grid.Column="0" Width="10" Height="10"
                                 Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="OmniStatus" Grid.Column="1" VerticalAlignment="Center"
                                   FontSize="12.5" Foreground="{StaticResource SubBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="BtnOmniRefresh" Grid.Column="2" Content="立即刷新" Style="{StaticResource FlatButton}"
                                MinWidth="88" Click="OmniRefresh_Click" />
                        <Button x:Name="BtnOmniStop" Grid.Column="3" Content="停止" Style="{StaticResource DangerButton}"
                                MinWidth="64" IsEnabled="False" Click="OmniStop_Click" />
                        <Button x:Name="BtnOmniStart" Grid.Column="4" Content="启动核心" Style="{StaticResource PrimaryButton}"
                                Click="OmniStart_Click" />
                    </Grid>
                    <!-- 模式级操作行 -->
                    <Grid ColumnSpacing="12" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="系统代理" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource SubBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="OmniSysProxyState" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource WeakBrush}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" x:Name="BtnOmniProxyOn" Content="开启系统代理" Style="{StaticResource FlatButton}"
                                MinWidth="104" Click="OmniSysProxyOn_Click" />
                        <Button Grid.Column="3" x:Name="BtnOmniProxyOff" Content="关闭系统代理" Style="{StaticResource DangerButton}"
                                MinWidth="104" Click="OmniSysProxyOff_Click" />
                        <TextBlock Grid.Column="4" Text="TUN 模式" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{StaticResource SubBrush}" FontWeight="SemiBold" />
                        <Button Grid.Column="5" x:Name="BtnOmniTun" Content="开启 TUN 模式" Style="{StaticResource FlatButton}"
                                MinWidth="104" Click="OmniTun_Click" />
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== KPI ===== -->
                <Grid x:Name="KpiGrid" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiTotal" Style="{StaticResource KpiValue}" /><TextBlock Text="总连接" Style="{StaticResource KpiLabel}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiActive" Style="{StaticResource KpiValue}" /><TextBlock Text="活跃连接" Style="{StaticResource KpiLabel}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiUp" Style="{StaticResource KpiValue}" /><TextBlock Text="上传" Style="{StaticResource KpiLabel}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiDown" Style="{StaticResource KpiValue}" /><TextBlock Text="下载" Style="{StaticResource KpiLabel}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiErrors" Style="{StaticResource KpiValue}" /><TextBlock Text="错误" Style="{StaticResource KpiLabel}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel><TextBlock x:Name="KpiUptime" Style="{StaticResource KpiValue}" /><TextBlock Text="运行时长" Style="{StaticResource KpiLabel}" /></StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 出站 + 监听器（并排） ===== -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <!-- 出站 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="出站链路" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.6*" /><ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="0.6*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource Th}" /><TextBlock Grid.Column="1" Text="协议" Style="{StaticResource Th}" />
                                <TextBlock Grid.Column="2" Text="目标" Style="{StaticResource Th}" /><TextBlock Grid.Column="3" Text="健康" Style="{StaticResource Th}" />
                                <TextBlock Grid.Column="4" Text="连接" Style="{StaticResource Th}" /><TextBlock Grid.Column="5" Text="活跃" Style="{StaticResource Th}" />
                                <TextBlock Grid.Column="6" Text="错误" Style="{StaticResource Th}" /><TextBlock Grid.Column="7" Text="↑" Style="{StaticResource Th}" />
                                <TextBlock Grid.Column="8" Text="↓" Style="{StaticResource Th}" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource LineBrush}" />
                            <ListView x:Name="ObList" MaxHeight="260" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.6*" /><ColumnDefinition Width="0.6*" />
                                                <ColumnDefinition Width="0.6*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Td}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Protocol}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Target}" Style="{StaticResource Td}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="10,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding HealthText}" Style="{StaticResource Td}" Margin="0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding Connections}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Active}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Errors}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="7" Text="{Binding Up}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="8" Text="{Binding Down}" Style="{StaticResource Td}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                    <!-- 监听器 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="监听器" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="协议" Style="{StaticResource Th}" /><TextBlock Grid.Column="1" Text="绑定地址" Style="{StaticResource Th}" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource LineBrush}" />
                            <ListView x:Name="LsList" MaxHeight="260" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" /><ColumnDefinition Width="1.6*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Protocol}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Bind}" Style="{StaticResource Td}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 路由 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="路由规则" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="0.6*" /><ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource Th}" /><TextBlock Grid.Column="1" Text="匹配" Style="{StaticResource Th}" />
                            <TextBlock Grid.Column="2" Text="模式" Style="{StaticResource Th}" /><TextBlock Grid.Column="3" Text="出口" Style="{StaticResource Th}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineBrush}" />
                        <ListView x:Name="RtList" MaxHeight="200" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="0.6*" /><ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Td}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Match}" Style="{StaticResource Td}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding Mode}" Style="{StaticResource Td}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Outbound}" Style="{StaticResource Td}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                </StackPanel>
<StackPanel x:Name="SbSection">
<TextBlock Text="sing-box 节点" Style="{StaticResource DividerTitle}" />

                <!-- ===== sing-box 状态条 ===== -->
                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                    <StackPanel Spacing="0">
                        <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="SbDot" Grid.Column="0" Width="10" Height="10" Fill="#4A5568" VerticalAlignment="Center" />
                        <TextBlock x:Name="SbStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{StaticResource SubBrush}" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="BtnSubAll" Grid.Column="2" Content="更新全部订阅" Style="{StaticResource FlatButton}" MinWidth="100" Click="SubUpdateAll_Click" />
                        <Button x:Name="BtnSbVersion" Grid.Column="3" Content="检查/更新版本" Style="{StaticResource FlatButton}" MinWidth="110" Click="SbVersion_Click" />
                        <Button x:Name="BtnSbStop" Grid.Column="4" Content="停止" Style="{StaticResource DangerButton}" MinWidth="64" IsEnabled="False" Click="SbStop_Click" />
                        <Button x:Name="BtnSbStart" Grid.Column="5" Content="启动核心" Style="{StaticResource PrimaryButton}" Click="SbStart_Click" />
                    </Grid>
                    <!-- 系统代理行 -->
                    <Grid ColumnSpacing="12" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="系统代理" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource SubBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SbSysProxyState" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource WeakBrush}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" x:Name="BtnSbProxyOn" Content="开启系统代理" Style="{StaticResource FlatButton}"
                                MinWidth="104" Click="SbSysProxyOn_Click" />
                        <Button Grid.Column="3" x:Name="BtnSbProxyOff" Content="关闭系统代理" Style="{StaticResource DangerButton}"
                                MinWidth="104" Click="SbSysProxyOff_Click" />
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 节点清单 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="节点清单（singbox-config.json）" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="0.5*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="节点" Style="{StaticResource Th}" /><TextBlock Grid.Column="1" Text="协议" Style="{StaticResource Th}" />
                            <TextBlock Grid.Column="2" Text="服务器" Style="{StaticResource Th}" /><TextBlock Grid.Column="3" Text="端口" Style="{StaticResource Th}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineBrush}" />
                        <ListView x:Name="NodeList" MaxHeight="220" SelectionMode="Single" IsItemClickEnabled="True" SelectionChanged="NodeList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="0.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Tag}" Style="{StaticResource Td}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource Td}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Server}" Style="{StaticResource Td}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Port}" Style="{StaticResource Td}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                            <ComboBox x:Name="SubSource" MinWidth="260" PlaceholderText="订阅源（sub 文件）"
                                      FontSize="12.5" />
                            <Button x:Name="BtnSub" Content="更新该订阅" Style="{StaticResource PrimaryButton}"
                                    Click="SubUpdate_Click" />
                            <Button x:Name="BtnSetDefault" Content="设为默认节点" Style="{StaticResource FlatButton}"
                                    IsEnabled="False" Click="SetDefaultNode_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 更新输出 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="更新输出" FontWeight="Bold" FontSize="14" />
                        <TextBox x:Name="SbOutput" Height="110" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                 Background="{StaticResource ConsoleBgBrush}" Foreground="#C9D4EC"
                                 BorderBrush="{StaticResource LineBrush}" CornerRadius="14" />
                    </StackPanel>
                </Border>

                </StackPanel>
<TextBlock Text="工具链" Style="{StaticResource DividerTitle}" />

                <!-- ===== 入口 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="入口" FontWeight="Bold" FontSize="14" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="sing-box 官方配置要求" Style="{StaticResource FlatButton}" Click="OpenDocs_Click" />
                            <Button Grid.Column="1" Content="官方文档（在线）" Style="{StaticResource FlatButton}" Click="OpenOfficial_Click" />
                            <Button Grid.Column="2" Content="开发进度报告" Style="{StaticResource FlatButton}" Click="OpenReport_Click" />
                            <Button Grid.Column="3" Content="打开日志目录" Style="{StaticResource FlatButton}" Click="OpenLogDir_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 日志 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="omni-proxy 日志（自动尾随）" FontWeight="Bold" FontSize="14" />
                            <CheckBox x:Name="ChkFollow" Content="自动滚动到底部" IsChecked="True"
                                      HorizontalAlignment="Right" Foreground="{StaticResource SubBrush}" />
                        </Grid>
                        <TextBox x:Name="LogBox" Height="180" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap"
                                 Background="{StaticResource ConsoleBgBrush}" Foreground="#C9D4EC"
                                 BorderBrush="{StaticResource LineBrush}" CornerRadius="14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
