<Application
    x:Class="OmniProxyGui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 扁平 + 圆润 主题（与 proxy_gui.py QSS 同源色板） ===== -->
            <SolidColorBrush x:Key="BgBrush" Color="#0F1219" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#171B25" />
            <SolidColorBrush x:Key="Surface2Brush" Color="#1E2431" />
            <SolidColorBrush x:Key="LineBrush" Color="#232A3A" />
            <SolidColorBrush x:Key="InkBrush" Color="#E9EDF7" />
            <SolidColorBrush x:Key="SubBrush" Color="#8D98AD" />
            <SolidColorBrush x:Key="WeakBrush" Color="#5F6A80" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#6B7AFF" />
            <SolidColorBrush x:Key="PrimaryStrongBrush" Color="#8190FF" />
            <SolidColorBrush x:Key="GreenBrush" Color="#2FB87F" />
            <SolidColorBrush x:Key="RedBrush" Color="#EF5F6B" />
            <SolidColorBrush x:Key="HeaderBgBrush" Color="#1A1F2B" />
            <SolidColorBrush x:Key="ConsoleBgBrush" Color="#10141D" />

            <!-- 卡片 Border -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="18,16" />
            </Style>

            <!-- 按钮（扁平：透明底 + 细边框 + 大圆角） -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#C9D1E4" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Foreground" Value="#FF8D97" />
                <Setter Property="BorderBrush" Value="#3A2A33" />
            </Style>

            <!-- KPI 数字/标签 -->
            <Style x:Key="KpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="21" />
                <Setter Property="FontWeight" Value="ExtraBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            </Style>
            <Style x:Key="KpiLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
            </Style>

            <!-- 分隔标题 -->
            <Style x:Key="DividerTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
                <Setter Property="Margin" Value="4,10,0,6" />
            </Style>

            <!-- 表格：表头/单元格 -->
            <Style x:Key="Th" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
                <Setter Property="Margin" Value="10,6" />
            </Style>
            <Style x:Key="Td" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Margin" Value="10,6" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
